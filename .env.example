# Copy to .env for local development. Never commit real secrets.
# Every variable is described in docs/setup.md.

# --- Database ---
DATABASE_URL=postgresql://research:research@localhost:5432/research_loop

# --- Provider credentials ---
OPENAI_API_KEY=
ZAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=
# Optional: restrict enabled providers (otherwise providers with keys are enabled).
RESEARCH_ENABLED_PROVIDERS=

# --- Model routing ---
# IMPORTANT: verify every model ID against the provider account before paid runs.
RESEARCH_PLANNER_MODEL=anthropic:claude-opus-5
RESEARCH_SCOUT_MODEL=zai:glm-5.3
RESEARCH_CHEAP_SCOUT_MODEL=openai:gpt-5.6-luna
RESEARCH_GAP_MODEL=openai:gpt-5.6-sol
RESEARCH_DEEP_MODEL=openai:gpt-5.6-sol
RESEARCH_SYNTH_MODEL=anthropic:claude-opus-5
RESEARCH_VERIFY_MODEL=openai:gpt-5.6-sol
RESEARCH_MULTIMODAL_MODEL=google:gemini-3.8-flash
RESEARCH_ALT_DEEP_MODEL=xai:grok-4.5
RESEARCH_BREADTH_SCOUT_MODEL=openai:gpt-5.6-luna
RESEARCH_GLM_GAP_MODEL=zai:glm-5.3
RESEARCH_GLM_CHEAP_MODEL=zai:glm-5.3-flash

# --- Optional observability ---
# Requires pip install -e ".[observability]" and a Logfire write token or `logfire auth` plus `logfire projects use <project-name>`.
RESEARCH_LOGFIRE_ENABLED=false
LOGFIRE_TOKEN=

# --- Local experiment paths ---
RESEARCH_BENCHMARK_CACHE=.cache/research-loop
RESEARCH_BENCHMARK_OUTPUT=benchmark_outputs
RESEARCH_BENCHMARK_CONCURRENCY=1

# --- Acquisition (docs/acquisition.md) ---
# Cache mode for web and scholarly tools in library runs; benchmarks force off, long-horizon runs record.
OPENALEX_API_KEY=
CROSSREF_MAILTO=
RESEARCH_SCHOLAR_CACHE_MODE=live
GROBID_URL=
