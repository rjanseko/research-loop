# Copy to .env for local development. Never commit real secrets.
# Exported environment variables override this file. docs/setup.md describes every variable.

# --- Database: runs are stored when this is set ---
DATABASE_URL=postgresql://research:research@localhost:5432/research_loop

# --- Provider keys: a provider is enabled when its key is set ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ZAI_API_KEY=
GOOGLE_API_KEY=
# Optional: allow only these providers, comma-separated.
RESEARCH_ENABLED_PROVIDERS=

# --- Models: provider:model per role. Verify IDs with `research doctor --smoke` before paid runs. ---
# The defaults are the settings study's lineup; set a line only to change it.
# RESEARCH_MODELS__PLANNER=openai:gpt-6-sol
# RESEARCH_MODELS__SCOUT=zai:glm-5.3-flash
# RESEARCH_MODELS__SYNTHESIZER=anthropic:claude-opus-5-5
# RESEARCH_MODELS__FALLBACK=openai:gpt-6-sol

# --- Limits per Scout run (docs/scout.md) ---
# RESEARCH_LIMITS__COST_USD=0.75
# RESEARCH_LIMITS__DEADLINE_SECONDS=360
# RESEARCH_LIMITS__MAX_QUESTIONS=4

# --- Tracing: on by default; sent to Logfire when a token is set ---
LOGFIRE_TOKEN=
# RESEARCH_LOGFIRE=false

# --- Research tools ---
# Cache for searches, pages, and scholarly records: off, live, record, replay, or reuse.
RESEARCH_CACHE_MODE=live
RESEARCH_CACHE_DIR=.cache/research-loop
OPENALEX_API_KEY=
CROSSREF_MAILTO=
