# Copy to .env for local development. Never commit real secrets.
# Exported environment variables override this file. docs/configuration.md inventories every setting
# and the fixed limits, with their current code defaults.

# --- Database: runs are stored when this is set ---
DATABASE_URL=postgresql://research:research@localhost:5432/research_loop

# --- Provider keys: a provider is enabled when its key is set ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ZAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
# Optional: allow only these providers, comma-separated.
RESEARCH_ENABLED_PROVIDERS=

# --- Models: provider:model@effort per role; the effort (low, medium, high, xhigh) is required. ---
# Verify IDs with `research doctor --smoke` before paid runs. The defaults are below; set a line only to change it.
# RESEARCH_MODELS__PLANNER=openai:gpt-6-sol@high
# RESEARCH_MODELS__SCOUT=openai:gpt-6-luna@high
# A second scout model for every other scout and deep dive of a deep run, on its own rate limit; off when unset.
# RESEARCH_MODELS__SCOUT_ALT=zai:glm-5.3@xhigh
# RESEARCH_MODELS__SYNTHESIZER=anthropic:claude-opus-5-5@medium
# RESEARCH_MODELS__FALLBACK=openai:gpt-6-sol@high
# RESEARCH_MODELS__JUDGE=openai:gpt-6-sol@high

# --- Limits per Scout run (README.md) ---
# RESEARCH_LIMITS__COST_USD=0.75
# RESEARCH_LIMITS__DEADLINE_SECONDS=720
# RESEARCH_LIMITS__MAX_QUESTIONS=4

# --- Provider token rate limits per minute; scouts on a listed model are paced under it. Unset, the limit
# OpenAI reports with each response replaces the default below; set, it is fixed. '{}' turns pacing off. ---
# RESEARCH_TOKENS_PER_MINUTE={"openai:gpt-6-luna": 2000000}

# --- Tracing: on by default; sent to Logfire when a token is set ---
LOGFIRE_TOKEN=
# RESEARCH_LOGFIRE=false

# --- Research tools ---
# Cache for searches, pages, and scholarly records: off, live, record, replay, or reuse.
# RESEARCH_CACHE_MODE=live
# RESEARCH_CACHE_DIR=.cache/research-loop
OPENALEX_API_KEY=
# Web search engine for the scouts: duckduckgo (default), serper, brave, exa, or an ordered
# comma-separated chain. hybrid means duckduckgo,exa. Paid engines need their keys.
RESEARCH_SEARCH_ENGINE=duckduckgo
EXA_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
# Readers tried in order when our fetch cannot read a page: oa, exa, firecrawl. Unset, it is every reader
# that can run: oa (free) always, exa and firecrawl when their keys are set. An empty value turns it off.
# RESEARCH_READ_FALLBACK=oa,exa,firecrawl
FIRECRAWL_API_KEY=
CROSSREF_MAILTO=
