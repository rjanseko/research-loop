# Copy to .env for local development. Never commit real secrets.
# Every variable is described in docs/setup.md.

# --- Database ---
DATABASE_URL=postgresql://research:research@localhost:5432/research_loop

# --- Model credentials ---
# Model calls use OPENROUTER_API_KEY from the process environment.
# A value in this file is ignored. Export it in the shell instead.

# --- Model routing ---
# Ids are openrouter:<author>/<slug>. Confirm them with `research-diagnose --smoke` before paid runs.
RESEARCH_PLANNER_MODEL=openrouter:anthropic/claude-opus-5
RESEARCH_SCOUT_MODEL=openrouter:z-ai/glm-5.3
RESEARCH_CHEAP_SCOUT_MODEL=openrouter:openai/gpt-5.6-luna
RESEARCH_GAP_MODEL=openrouter:openai/gpt-5.6-sol
RESEARCH_DEEP_MODEL=openrouter:openai/gpt-5.6-sol
RESEARCH_SYNTH_MODEL=openrouter:anthropic/claude-opus-5
RESEARCH_VERIFY_MODEL=openrouter:openai/gpt-5.6-sol
RESEARCH_MULTIMODAL_MODEL=openrouter:google/gemini-3.8-flash
RESEARCH_ALT_DEEP_MODEL=openrouter:x-ai/grok-4.5
RESEARCH_BREADTH_SCOUT_MODEL=openrouter:openai/gpt-5.6-luna
RESEARCH_GLM_GAP_MODEL=openrouter:z-ai/glm-5.3
RESEARCH_GLM_CHEAP_MODEL=openrouter:z-ai/glm-5.3-flash

# --- Optional observability ---
# Requires pip install -e ".[observability]" and a Logfire write token or `logfire auth` plus `logfire projects use <project-name>`.
RESEARCH_LOGFIRE_ENABLED=false
LOGFIRE_TOKEN=

# --- Local experiment paths ---
RESEARCH_BENCHMARK_CACHE=.cache/research-loop
RESEARCH_BENCHMARK_OUTPUT=benchmark_outputs
RESEARCH_BENCHMARK_CONCURRENCY=1

# --- Acquisition (docs/acquisition.md) ---
# Cache mode for web and scholarly tools in library runs; benchmarks force off, campaigns record.
OPENALEX_API_KEY=
CROSSREF_MAILTO=
RESEARCH_SCHOLAR_CACHE_MODE=live
GROBID_URL=
